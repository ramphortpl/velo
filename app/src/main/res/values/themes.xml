<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de démarrage : écran d'accueil aux couleurs de VeloGo, puis thème de l'appli (tout le reste est en Compose). -->
    <style name="Theme.VeloGo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/velogo_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VeloGo</item>
    </style>

    <style name="Theme.VeloGo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
